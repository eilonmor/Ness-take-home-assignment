# Copy to .env (git-ignored) and adjust. Every value is optional;
# blank values are ignored and the profile in config/ applies.

# Settings profile: dev | ci
ENV=dev

# One-off overrides of the profile
HEADLESS=
SLOW_MO=
BROWSER=
BASE_URL=

# Experimental (bot-protection branch): hide automation flags; drive installed Chrome
STEALTH=
BROWSER_CHANNEL=

# Seed for the random variant choices (replays a run's picks; the seed is logged)
RANDOM_SEED=

# Login. Guest is the default because eBay sign-in shows captcha/bot checks.
# For a real sign-in set EBAY_GUEST=false and fill both credentials.
EBAY_GUEST=true
EBAY_USERNAME=
EBAY_PASSWORD=
